NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional override. Leave empty to use the first workspace returned by GET /api/v1/auth/me/tenants.
NEXT_PUBLIC_ROUTE_BRIDGE_TENANT_ID=
# Local dev: set Clerk keys here AND ROUTEBRIDGE_CLERK_JWKS_URL on the backend, or leave both unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# NOTE: do not enable ROUTEBRIDGE_REQUIRE_API_KEY on the backend for browser traffic; the browser cannot
# hold a secret. Browser calls are authenticated with the Clerk Bearer token only.
