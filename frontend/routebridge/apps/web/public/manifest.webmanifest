{
  "name": "RouteBridge Driver",
  "short_name": "RB Driver",
  "description": "Offline-first delivery app for RouteBridge drivers",
  "start_url": "/driver",
  "scope": "/driver",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4faf7",
