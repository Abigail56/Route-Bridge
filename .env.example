# RouteBridge on Docker Desktop. Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# ---- passwords you invent (use long random ones; `python backend/apps/api/src/routebridge/tools/gen_secrets.py` can make them) ----
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# at least 32 characters (production insists on it)
DRIVER_TOKEN_SECRET=

# ---- sign-in: your Clerk application (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# your Clerk "Frontend API URL", e.g. https://xxxx.clerk.accounts.dev
CLERK_ISSUER=
# the same URL + /.well-known/jwks.json
CLERK_JWKS_URL=
# optional, starts with whsec_
CLERK_WEBHOOK_SECRET=
REQUIRE_CLERK_AUTH=true
# Your own Clerk user id(s) (user_...), written as a JSON list. They can create workspaces and open the Platform console.
PLATFORM_ADMIN_SUBJECTS=[]

# ---- text messages (SMS). "log" only writes them to the log; nothing is sent until you set "http" and your gateway details ----
SMS_PROVIDER=log
# true = you accept that NO texts are sent (they are only logged). Needed to run in production before you have an SMS account.
ALLOW_LOG_SMS=false
# how a customer gets the delivery code: dashboard = staff pass it on by hand (a card pops up on the dashboard; works with no SMS account), sms = texted automatically
OTP_DELIVERY=dashboard
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=RouteBridge
SMS_PAYLOAD_TEMPLATE=
SMS_AUTH_STYLE=bearer
# json (most gateways) or form (Twilio)
SMS_CONTENT_TYPE=json
# Twilio example: SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts/<AccountSid>/Messages.json
#   SMS_AUTH_STYLE=basic   SMS_CONTENT_TYPE=form   SMS_API_KEY=<API key SID>:<API key secret>
#   SMS_SENDER_ID=<your Twilio number, like +1555...>   SMS_PAYLOAD_TEMPLATE={"To":"{to}","From":"{from}","Body":"{message}"}

# ---- driver phone alerts (optional). Make the pair with: docker compose run --rm api python -m routebridge.tools.gen_secrets ----
# (copy ROUTEBRIDGE_VAPID_PUBLIC_KEY / _PRIVATE_KEY values here without the ROUTEBRIDGE_ prefix)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact address the phone makers can reach if our pushes misbehave, e.g. mailto:you@yourcompany.ng
VAPID_SUBJECT=

# ---- plans and payments: leave as is until you are ready to charge ----
# true = plan limits (riders, people, merchants, orders a month) are enforced and ended plans block NEW work
BILLING_ENFORCED=false
# from dashboard.paystack.com (sk_test_... to try, sk_live_... to charge). Also set the webhook there to <your API address>/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
# where Paystack sends people back after paying, e.g. https://app.yourcompany.ng/settings
PAYSTACK_CALLBACK_URL=

# ---- monitoring (optional): docker compose --profile monitoring up -d ----
# password for the Grafana dashboard (user: admin) at http://localhost:3001
GRAFANA_ADMIN_PASSWORD=
# where alerts are posted (any service that accepts a webhook, e.g. a Slack/Discord/Make/Zapier hook). Empty = alerts only appear on screen
ALERT_WEBHOOK_URL=

# ---- Twilio text messages: the simple way. Set SMS_PROVIDER=twilio and fill these four lines (no URL or template needed) ----
# (leave SMS_PROVIDER=log and nothing is sent). Find the SID and token on console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# your Twilio number in international form, like +15551234567. OR use a messaging service instead (next line). OR an approved sender name in SMS_SENDER_ID
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---- email through Resend (resend.com). Shops that give an email address get order and claim emails ----
RESEND_API_KEY=
# a sender on a domain you verified in Resend, like: RouteBridge Logistics <alerts@yourdomain.com>. Empty = Resend's test sender, which only emails YOU
EMAIL_FROM=
EMAIL_REPLY_TO=
# auto = use Resend when the key is set; log = never send
EMAIL_PROVIDER=auto

# ---- going live (leave all of this empty while you are just trying it on your own computer) ----
# The real https addresses people will use. They are baked into the web app, so rebuild after changing them.
# e.g. https://app.yourcompany.ng
PUBLIC_WEB_URL=
# e.g. https://api.yourcompany.ng
PUBLIC_API_URL=
# e.g. https://files.yourcompany.ng  (where delivery photos go)
PUBLIC_MEDIA_URL=
# the same three names without https://, for the HTTPS proxy
APP_DOMAIN=
API_DOMAIN=
FILES_DOMAIN=
# set to 127.0.0.1 on the server so only the HTTPS proxy is reachable from the internet
BIND_ADDRESS=0.0.0.0
# Make these with: docker compose run --rm api python -m routebridge.tools.gen_secrets
INTERNAL_API_KEY=
WEBHOOK_SIGNING_SECRET=
# true in production
VERIFY_WEBHOOK_SIGNATURES=false

# ---- optional: addresses on your computer, session time and names (the defaults are fine) ----
WEB_PORT=3000
API_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=routebridge
S3_BUCKET=routebridge-photos
# Map pictures. osm = free OpenStreetMap, fine for trying things out. For real use choose maptiler or mapbox and paste that provider's key.
# (Map keys are public by design: in the provider's dashboard, restrict the key to your website address.)
MAP_PROVIDER=osm
MAP_API_KEY=
# optional: any other tile service address (overrides the two lines above)
MAP_TILE_URL=
MAP_ATTRIBUTION=
# Arrival times by road. none = the plain straight-line estimate. osrm = road distances, no traffic (the free public server is for trying only).
# mapbox = road times WITH live traffic: put a Mapbox access token in ROUTE_API_KEY (keep it secret; this one is used by the server, not the browser).
ROUTE_PROVIDER=none
ROUTE_API_KEY=
ROUTE_OSRM_URL=
# Average city speed in km/h for the "about N minutes away" estimate
ETA_SPEED_KMH=22
SESSION_MAX_HOURS=12
SESSION_IDLE_MINUTES=30
ENVIRONMENT=development
