{
  "uid": "routebridge-overview",
  "title": "RouteBridge health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "API", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"routebridge-api\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "options": { "colorMode": "background" } },
    { "id": 2, "type": "stat", "title": "Requests per second", "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "targets": [{ "expr": "sum(rate(routebridge_http_requests_total[5m]))", "refId": "A" }], "fieldConfig": { "defaults": { "decimals": 2 } } },
    { "id": 3, "type": "stat", "title": "Failing requests (5xx)", "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(routebridge_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(routebridge_http_requests_total[5m])), 0.001)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } } }, "options": { "colorMode": "background" } },
    { "id": 4, "type": "stat", "title": "Average response time", "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [{ "expr": "sum(rate(routebridge_http_request_seconds_sum[5m])) / clamp_min(sum(rate(routebridge_http_request_seconds_count[5m])), 0.001)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 1.5 }] } } }, "options": { "colorMode": "background" } },
    { "id": 5, "type": "stat", "title": "Open cash reconciliations", "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "targets": [{ "expr": "routebridge_reconciliation_open", "refId": "A" }] },
    { "id": 6, "type": "timeseries", "title": "Requests by result", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(routebridge_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }] },
    { "id": 7, "type": "timeseries", "title": "Slowest routes (avg seconds)", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "topk(5, rate(routebridge_http_request_seconds_sum[5m]) / clamp_min(rate(routebridge_http_request_seconds_count[5m]), 0.001))", "legendFormat": "{{route}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 8, "type": "timeseries", "title": "Background events", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "routebridge_outbox_pending", "legendFormat": "waiting", "refId": "A" }, { "expr": "routebridge_outbox_dead_letter", "legendFormat": "gave up", "refId": "B" }] },
    { "id": 9, "type": "timeseries", "title": "Customer messages", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "routebridge_notifications_queued", "legendFormat": "queued", "refId": "A" }, { "expr": "routebridge_notifications_failed", "legendFormat": "failed", "refId": "B" }, { "expr": "routebridge_notification_oldest_due_seconds", "legendFormat": "oldest waiting (s)", "refId": "C" }] }
  ]
}
