ROUTEBRIDGE_ENVIRONMENT=development
ROUTEBRIDGE_DEBUG=true
ROUTEBRIDGE_DATABASE_URL=sqlite:///./routebridge.db
ROUTEBRIDGE_DEFAULT_COUNTRY_CODE=NG
ROUTEBRIDGE_DEFAULT_CURRENCY=NGN
ROUTEBRIDGE_DEFAULT_TIMEZONE=Africa/Lagos
ROUTEBRIDGE_ALLOWED_ORIGINS=["http://localhost:3000"]
ROUTEBRIDGE_REQUIRE_API_KEY=false
ROUTEBRIDGE_INTERNAL_API_KEY=
ROUTEBRIDGE_CLERK_JWKS_URL=
ROUTEBRIDGE_CLERK_ISSUER=
ROUTEBRIDGE_CLERK_AUDIENCE=
ROUTEBRIDGE_AUTH_ATTEMPT_LIMIT=5
ROUTEBRIDGE_AUTH_ATTEMPT_WINDOW_SECONDS=900
ROUTEBRIDGE_REDIS_URL=
ROUTEBRIDGE_WEBHOOK_SIGNING_SECRET=
ROUTEBRIDGE_VERIFY_WEBHOOK_SIGNATURES=false
ROUTEBRIDGE_REQUIRE_CLERK_AUTH=false
# Clerk Dashboard > Webhooks > your endpoint > Signing Secret (starts with whsec_). Endpoint URL: <api>/api/v1/webhooks/clerk
ROUTEBRIDGE_CLERK_WEBHOOK_SECRET=
ROUTEBRIDGE_REQUIRE_POSTGIS=false
ROUTEBRIDGE_MAX_OUTBOX_ATTEMPTS=8
# Platform operators (Clerk user ids) allowed to create tenants
ROUTEBRIDGE_PLATFORM_ADMIN_SUBJECTS=[]
# Public tracking links and notifications
ROUTEBRIDGE_PUBLIC_TRACKING_BASE_URL=http://localhost:3000/track
ROUTEBRIDGE_TRACKING_TOKEN_TTL_DAYS=30
ROUTEBRIDGE_SMS_PROVIDER=log
ROUTEBRIDGE_SMS_API_URL=
ROUTEBRIDGE_SMS_API_KEY=
ROUTEBRIDGE_SMS_SENDER_ID=RouteBridge
ROUTEBRIDGE_WHATSAPP_API_URL=
ROUTEBRIDGE_WHATSAPP_API_KEY=
# Geocoding: none | nominatim
ROUTEBRIDGE_GEOCODER_PROVIDER=none
# Driver device tokens (min 16 chars; required to issue driver tokens) and delivery OTPs
ROUTEBRIDGE_DRIVER_TOKEN_SECRET=
ROUTEBRIDGE_DRIVER_TOKEN_TTL_MINUTES=720
ROUTEBRIDGE_OTP_TTL_MINUTES=30
ROUTEBRIDGE_OTP_MAX_ATTEMPTS=5
# Vendor adapters: JSON body template with {to} {from} {message} {channel}; auth style: bearer | header:<Name> | body:<field>
ROUTEBRIDGE_SMS_PAYLOAD_TEMPLATE=
ROUTEBRIDGE_SMS_AUTH_STYLE=bearer
ROUTEBRIDGE_WHATSAPP_PAYLOAD_TEMPLATE=
ROUTEBRIDGE_WHATSAPP_AUTH_STYLE=bearer
# Masked calling (driver <-> customer bridged through proxy numbers): log | http
ROUTEBRIDGE_TELEPHONY_PROVIDER=log
ROUTEBRIDGE_TELEPHONY_API_URL=
ROUTEBRIDGE_TELEPHONY_API_KEY=
# Delivery photos: local (dev) | s3 (AWS S3 / MinIO / R2 via presigned URLs)
ROUTEBRIDGE_MEDIA_PROVIDER=local
ROUTEBRIDGE_MEDIA_DIR=./media
ROUTEBRIDGE_S3_ENDPOINT=
ROUTEBRIDGE_S3_BUCKET=
ROUTEBRIDGE_S3_REGION=af-south-1
ROUTEBRIDGE_S3_ACCESS_KEY=
ROUTEBRIDGE_S3_SECRET_KEY=
# Feature switches (JSON), e.g. {"masked_calls": false, "customer_corrections": false}
ROUTEBRIDGE_FEATURE_FLAGS={}
